{
    "manifest_version": 3,
    "name": "My React Extension",
    "version": "1.0",
    "action": {
      "default_popup": "index.html"
    },
    "permissions": ["storage", "tabs"],
    "background": {
        "service_worker": "background.js"
    },
    "omnibox": {
        "keyword": "/"
    },
    "commands": {
        "duplicate-tab": {
          "suggested_key": {
            "default": "Ctrl+Shift+U"
          },
          "description": "Duplicate the current tab"
        }
      }
  }